# Emek — local development environment
# Kopyala: cp .env.example .env
# BU DOSYA GERÇEK DEĞER İÇERMEZ. Secret'lar staging/production'da Secret Manager'dan gelir.

# --- Core API (services/api) ---
NODE_ENV=development
PORT=3000
LOG_LEVEL=debug

# infra/docker/docker-compose.yml ile uyumlu
DATABASE_URL=postgres://emek:emek_local_dev@localhost:5432/emek
DATABASE_POOL_MAX=10

# Integration testleri YALNIZCA bu veritabanını kullanır ve şemasını sıfırlar.
# Adı '_test' ile bitmek zorundadır; bitmezse test koşucusu başlamayı reddeder.
DATABASE_URL_TEST=postgres://emek:emek_local_dev@localhost:5432/emek_test
REDIS_URL=redis://localhost:6379

# Sağlayıcı seçimi. 'mock' yalnızca development/test içindir;
# NODE_ENV=production ile birlikte seçilirse servis başlamaz (ADR-0005, ADR-0009).
IDENTITY_PROVIDER=mock
PAYMENT_PROVIDER=mock

# --- Identity hash anahtarı (ADR-0004, R-39) ---
# 'env' yalnızca geliştirme içindir; production'da 'kms' zorunludur.
# KMS kaynağında anahtar materyali uygulamaya **hiç** inmez: HMAC'i Cloud KMS
# hesaplar (macSign). Anahtar sürümü açıkça yazılır — "primary"ye bırakmak,
# KMS tarafındaki bir değişikliğin tekilliği sessizce bozmasına izin verirdi.
IDENTITY_HASH_KEY_SOURCE=env
# IDENTITY_KMS_KEY_NAME=projects/<p>/locations/<l>/keyRings/<r>/cryptoKeys/identity-hash/cryptoKeyVersions/1

# Python AI servisi (services/ai)
AI_SERVICE_URL=http://localhost:8000
AI_SERVICE_TIMEOUT_MS=3000

# Google Cloud — local'de Pub/Sub emulator kullanılır
GCP_PROJECT_ID=emek-local
# `npm run infra:up:events` ile emulator ayaktaysa açın. Ayarlıysa outbox transport'u
# otomatik olarak pubsub'a geçer (ADR-0010) — emulator çalışmıyorken açık bırakmak
# publish çağrılarının 10 sn zaman aşımına uğramasına yol açar (ör. `npm test:integration`).
# PUBSUB_EMULATOR_HOST=localhost:8085

# --- AI service (services/ai) ---
AI_ENVIRONMENT=development
AI_PORT=8000
AI_LOG_LEVEL=debug

# --- Ödeme (ADR-0009) ---
# Webhook imzası bu sırla doğrulanır; production'da Secret Manager'dan gelir.
PAYMENT_WEBHOOK_SECRET=local-development-payment-secret
# Yetkilendirmenin geçerlilik süresi (saat). Hizmet günü bundan sonraysa yenileme gerekir.
PAYMENT_AUTHORIZATION_TTL_HOURS=168
PAYMENT_REAUTH_THRESHOLD_HOURS=24
PAYMENT_MAX_REAUTHORIZATIONS=3

# --- Object storage (dijital ispat) ---
# Nesneler private'tır; erişim yalnızca kısa ömürlü signed URL ile olur.
# 'gcs' production'da zorunludur. Bucket'ın private + uniform access + public
# access prevention taşıdığı **boot'ta doğrulanır**; taşımıyorsa servis başlamaz (R-41).
STORAGE_PROVIDER=mock
STORAGE_BUCKET=emek-local-documents
STORAGE_SIGNING_SECRET=local-development-storage-secret
STORAGE_SIGNED_URL_TTL_SECONDS=300
STORAGE_MAX_UPLOAD_BYTES=10485760

# --- AI servisi ve zaman dilimi (Faz 6) ---
# NLP çıktısındaki saatler yerel saattir; mutlak ana bu ofsetle çevrilir.
# Türkiye 2016'dan beri yaz saati uygulamıyor (sabit UTC+03:00).
SERVICE_TIMEZONE_OFFSET=+03:00
# Servisler arası paylaşılan sır. Production'da her iki serviste de zorunludur.
# AI_SERVICE_API_KEY=local-development-service-key
# AI_PARSER_VERSION=heuristic-v1

# --- Matching / Optimization (Faz 7, ADR-0007 & ADR-0018) ---
# Karar motoru çağrısının zaman aşımı. NLP'den uzun: optimizasyon kombinatoryal bir
# problemi çözer. Süre dolduğunda core kendi deterministik yedek sıralamasına düşer.
MATCHING_SERVICE_TIMEOUT_MS=10000
# Mutlak mesafe üst sınırı. Hizmet bölgesi poligonu "evet" dese bile aşılamaz.
# Bu değer **istekle birlikte** motora taşınır; iki tarafın ayrışması mümkün değildir.
MATCHING_MAX_DISTANCE_METERS=50000
# Tek talep için değerlendirilecek en fazla aday ("en yakın N").
MATCHING_CANDIDATE_LIMIT=50
# Tek toplu çalıştırmada birlikte çözülecek en fazla talep.
MATCHING_BATCH_LIMIT=25

# AI servisi tarafı — core ile tutarlı olmak zorunda olanlar işaretli.
# Hizmet zaman dilimi: SERVICE_TIMEZONE_OFFSET ile AYNI olmalı.
AI_SERVICE_TIMEZONE_OFFSET=+03:00
# Yalnızca varsayılan: core her istekte kendi değerini gönderir ve o ezer.
AI_MATCHING_MAX_DISTANCE_METERS=50000
# Motorun kendi üst sınırları — çağıranın sınırlarına güvenmez (deny by default).
AI_OPTIMIZATION_MAX_BOOKINGS=50
AI_OPTIMIZATION_MAX_CANDIDATES_PER_BOOKING=50
# CP-SAT zaman limiti (saniye). Aşılırsa işaretli fallback devreye girer.
AI_OPTIMIZATION_TIME_LIMIT_SECONDS=5.0
# Sürüm etiketleri (ADR-0012 §1): her karar bunları taşır ve saklar.
# AI_MATCHING_ALGORITHM_VERSION=matching-v1
# AI_MATCHING_WEIGHTS_VERSION=weights-v1
# AI_OPTIMIZATION_OBJECTIVE_VERSION=objective-v1

# --- Safety (Faz 8, ADR-0008 & ADR-0019) ---
# Anomali modeli çağrısının zaman aşımı (ms). Kısa: skor destekleyicidir; süre dolunca
# değerlendirme kurallarla tamamlanır. Panik bu çağrıyı hiç yapmaz.
SAFETY_ANOMALY_TIMEOUT_MS=1500
# Oturum açılırken kopyalanan geofence varsayılanları (tek evrensel yarıçap yok, R-56).
SAFETY_GEOFENCE_RADIUS_METERS=150
SAFETY_GEOFENCE_ACCURACY_LIMIT_METERS=100
SAFETY_GEOFENCE_DEBOUNCE_SAMPLES=3
# İstemcinin konum gönderme aralığı ve sunucunun zaman toleransları (saniye).
SAFETY_TELEMETRY_INTERVAL_SECONDS=30
SAFETY_TELEMETRY_MAX_SKEW_SECONDS=120
SAFETY_TELEMETRY_MAX_AGE_SECONDS=900
# Doğruluk daireleri düşüldükten sonra fiziksel olarak mümkün azami hız (m/sn).
SAFETY_MAX_SPEED_MPS=60
# Aynı oturum için iki risk değerlendirmesi arası (saniye) ve izleyici turu.
SAFETY_EVALUATION_INTERVAL_SECONDS=120
SAFETY_MONITOR_ENABLED=true
SAFETY_MONITOR_INTERVAL_SECONDS=30
# Ham konum saklama (gün). TODO(legal): hukuk görüşüyle doğrulanacak (A-04, R-58).
SAFETY_LOCATION_RETENTION_DAYS=30
SAFETY_EVIDENCE_RETENTION_DAYS=365
# AI servisi: anomali modeli sürümü (kayıtlı: anomaly-deviation-v1, anomaly-deviation-v2).
# AI_ANOMALY_MODEL_VERSION=anomaly-deviation-v2

# --- Event-Driven (Faz 9, ADR-0010) ---
# Transport: 'logging' (local default) veya 'pubsub'.
# PUBSUB_EMULATOR_HOST ayarlıysa transport otomatik olarak pubsub olur.
# Production'da 'pubsub' zorunludur; 'logging' ile boot reddedilir.
EVENT_TRANSPORT_TYPE=logging
# Zamanlanmış ödeme release (R-42). Mevcut guard'ların arkasında çalışır.
SCHEDULED_RELEASE_ENABLED=false
SCHEDULED_RELEASE_INTERVAL_MS=60000
SCHEDULED_RELEASE_DISPUTE_WINDOW_HOURS=48

# --- Faz 13 / dağıtım (ADR-0023) ---
# Not: çalışan revizyonun adı ayrıca yapılandırılmaz. Cloud Run `K_REVISION`
# değişkenini kendisi enjekte eder ve boot logunda raporlanır; public health
# ucunda **yayınlanmaz** (commit sürümü saldırgana hedef bilgisi verir).

# Retention-locked audit arşivi (ADR-0013 §8, R-82).
# 'memory' süreç yeniden başladığında kaybolur ve "bağımsız kopya" iddiasını
# taşıyamaz; production'da 'gcs' ve dışa aktarım zorunludur. Bucket'ın **kilitli**
# retention policy taşıdığı boot'ta doğrulanır.
AUDIT_ARCHIVE_PROVIDER=memory
# AUDIT_ARCHIVE_BUCKET=emek-staging-audit-archive

# Not: V4 imzalı URL, çalışma zamanının kendi kimliğiyle (Cloud Run servis hesabı,
# IAM signBlob) üretilir. Ayrı bir imzalayan ayarı yoktur ve uzun ömürlü bir JSON
# anahtar dosyası kullanılmaz (ADR-0023).
