# Emek — local development environment
# Kopyala: cp .env.example .env
# BU DOSYA GERÇEK DEĞER İÇERMEZ. Secret'lar staging/production'da Secret Manager'dan gelir.

# --- Core API (services/api) ---
NODE_ENV=development
PORT=3000
LOG_LEVEL=debug

# infra/docker/docker-compose.yml ile uyumlu
DATABASE_URL=postgres://emek:emek_local_dev@localhost:5432/emek
DATABASE_POOL_MAX=10

# Integration testleri YALNIZCA bu veritabanını kullanır ve şemasını sıfırlar.
# Adı '_test' ile bitmek zorundadır; bitmezse test koşucusu başlamayı reddeder.
DATABASE_URL_TEST=postgres://emek:emek_local_dev@localhost:5432/emek_test
REDIS_URL=redis://localhost:6379

# Sağlayıcı seçimi. 'mock' yalnızca development/test içindir;
# NODE_ENV=production ile birlikte seçilirse servis başlamaz (ADR-0005, ADR-0009).
IDENTITY_PROVIDER=mock
PAYMENT_PROVIDER=mock

# Python AI servisi (services/ai)
AI_SERVICE_URL=http://localhost:8000
AI_SERVICE_TIMEOUT_MS=3000

# Google Cloud — local'de Pub/Sub emulator kullanılır
GCP_PROJECT_ID=emek-local
PUBSUB_EMULATOR_HOST=localhost:8085

# --- AI service (services/ai) ---
AI_ENVIRONMENT=development
AI_PORT=8000
AI_LOG_LEVEL=debug

# --- Ödeme (ADR-0009) ---
# Webhook imzası bu sırla doğrulanır; production'da Secret Manager'dan gelir.
PAYMENT_WEBHOOK_SECRET=local-development-payment-secret
# Yetkilendirmenin geçerlilik süresi (saat). Hizmet günü bundan sonraysa yenileme gerekir.
PAYMENT_AUTHORIZATION_TTL_HOURS=168
PAYMENT_REAUTH_THRESHOLD_HOURS=24
PAYMENT_MAX_REAUTHORIZATIONS=3

# --- Object storage (dijital ispat) ---
# Nesneler private'tır; erişim yalnızca kısa ömürlü signed URL ile olur.
STORAGE_PROVIDER=mock
STORAGE_BUCKET=emek-local-documents
STORAGE_SIGNING_SECRET=local-development-storage-secret
STORAGE_SIGNED_URL_TTL_SECONDS=300
STORAGE_MAX_UPLOAD_BYTES=10485760

# --- AI servisi ve zaman dilimi (Faz 6) ---
# NLP çıktısındaki saatler yerel saattir; mutlak ana bu ofsetle çevrilir.
# Türkiye 2016'dan beri yaz saati uygulamıyor (sabit UTC+03:00).
SERVICE_TIMEZONE_OFFSET=+03:00
# Servisler arası paylaşılan sır. Production'da her iki serviste de zorunludur.
# AI_SERVICE_API_KEY=local-development-service-key
# AI_PARSER_VERSION=heuristic-v1
