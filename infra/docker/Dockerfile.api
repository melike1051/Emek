# Emek core API (NestJS) — Cloud Run için stateless container.
# Build context: repository kökü.
#   docker build -f infra/docker/Dockerfile.api -t emek-api .
# Production sertleştirmesi (distroless, SBOM, imza) Faz 13'te ele alınır.

FROM node:22-bookworm-slim AS deps
WORKDIR /app
COPY package.json package-lock.json ./
COPY services/api/package.json services/api/
RUN npm ci

FROM node:22-bookworm-slim AS build
WORKDIR /app
COPY --from=deps /app/node_modules ./node_modules
COPY . .
RUN npm run build --workspace=@emek/api

FROM node:22-bookworm-slim AS runtime
ENV NODE_ENV=production
WORKDIR /app

COPY package.json package-lock.json ./
COPY services/api/package.json services/api/
RUN npm ci --omit=dev && npm cache clean --force

COPY --from=build /app/services/api/dist ./services/api/dist
COPY services/api/migrations ./services/api/migrations

# node imajının hazır non-root kullanıcısı; root olarak çalıştırılmaz.
USER node

EXPOSE 3000
WORKDIR /app/services/api
CMD ["node", "dist/main.js"]
