# Emek operasyon (apps/admin) — kopyala: cp .env.example .env.local
# Core API origin'i; yalnızca Next.js sunucusu okur (aynı-origin proxy, ADR-0024 §5).
API_ORIGIN=http://localhost:3000

# 'mock' yalnızca yerel geliştirme: backend AUTH_PROVIDER=mock ile eşleşir. Production build reddeder.
NEXT_PUBLIC_AUTH_MODE=mock

# AUTH_MODE=firebase iken zorunlu.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Boşsa App Check başlatılmaz (backend APP_CHECK_ENABLED=false olmalı).
NEXT_PUBLIC_APP_CHECK_SITE_KEY=

# İstemci adresi (R-107, ADR-0026) — yalnız Next sunucusu okur. Core API'nin WEB_PROXY_SECRET'ıyla
# aynı değer; boşsa proxy adres başlığı eklemez (yerel geliştirme). CLIENT_IP_HOP_COUNT: web
# önündeki ön ucun X-Forwarded-For'a eklediği güvenilir hop sayısı (Cloud Run: ölçülene dek 1).
WEB_PROXY_SECRET=
CLIENT_IP_HOP_COUNT=1
