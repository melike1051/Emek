{
  "name": "@emek/api",
  "version": "0.1.0",
  "private": true,
  "description": "Emek core backend — NestJS",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "dotenv -e ../../.env -- node --watch --require ts-node/register src/main.ts",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "jest --config jest.config.js",
    "test:cov": "jest --config jest.config.js --coverage",
    "test:integration": "dotenv -e ../../.env -- jest --config jest.integration.config.js",
    "migrate:up": "dotenv -e ../../.env -- node-pg-migrate up",
    "migrate:down": "dotenv -e ../../.env -- node-pg-migrate down",
    "migrate:redo": "npm run migrate:down && npm run migrate:up",
    "seed:catalog": "dotenv -e ../../.env -- node --require ts-node/register scripts/seed-catalog.ts",
    "contracts:generate": "dotenv -e ../../.env -- node --require ts-node/register scripts/generate-openapi.ts",
    "exp:safety": "node --require ts-node/register scripts/exp-004-safety.ts",
    "exp:safety:latency": "dotenv -e ../../.env -- node --require ts-node/register scripts/exp-004-latency.ts"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.6",
    "@nestjs/core": "^11.1.6",
    "@nestjs/platform-express": "^11.1.6",
    "@nestjs/swagger": "^11.4.7",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "ioredis": "^5.4.2",
    "jose": "^5.10.0",
    "pg": "^8.13.1",
    "pino": "^9.6.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@nestjs/testing": "^11.1.6",
    "@types/express": "^5.0.0",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.10.2",
    "@types/pg": "^8.11.10",
    "@types/supertest": "^6.0.2",
    "dotenv-cli": "^8.0.0",
    "jest": "^29.7.0",
    "node-pg-migrate": "^9.0.0",
    "pino-pretty": "^13.0.0",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.0"
  }
}
