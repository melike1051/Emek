{
  "name": "emek",
  "version": "0.1.0",
  "private": true,
  "description": "Emek \u2014 iki tarafl\u0131 dijital hizmet pazaryeri platformu",
  "engines": {
    "node": ">=20.11.0"
  },
  "workspaces": [
    "services/api"
  ],
  "scripts": {
    "lint": "eslint .",
    "format:check": "prettier --check \"**/*.{ts,js,mjs,json,md,yml,yaml}\"",
    "format": "prettier --write \"**/*.{ts,js,mjs,json,md,yml,yaml}\"",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "test:integration": "npm run test:integration --workspaces --if-present",
    "infra:up": "docker compose -f infra/docker/docker-compose.yml up -d --wait",
    "infra:up:events": "docker compose -f infra/docker/docker-compose.yml --profile events up -d --wait",
    "infra:down": "docker compose -f infra/docker/docker-compose.yml down",
    "infra:reset": "docker compose -f infra/docker/docker-compose.yml down -v",
    "migrate:up": "npm run migrate:up --workspace=@emek/api",
    "migrate:down": "npm run migrate:down --workspace=@emek/api"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.11.0",
    "prettier": "^3.4.2",
    "typescript": "^6.0.0",
    "typescript-eslint": "^8.70.0"
  },
  "overrides": {
    "multer": "^2.4.0"
  }
}
