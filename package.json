{
  "name": "emek",
  "version": "0.1.0",
  "private": true,
  "description": "Emek — iki taraflı dijital hizmet pazaryeri platformu",
  "engines": {
    "node": ">=20.11.0"
  },
  "workspaces": [
    "services/api",
    "packages/api-contracts/*"
  ],
  "scripts": {
    "lint": "eslint .",
    "format:check": "prettier --check \"**/*.{ts,js,mjs,json,md,yml,yaml}\"",
    "format": "prettier --write \"**/*.{ts,js,mjs,json,md,yml,yaml}\"",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "test:integration": "npm run test:integration --workspaces --if-present",
    "infra:up": "docker compose -f infra/docker/docker-compose.yml up -d --wait",
    "infra:up:events": "docker compose -f infra/docker/docker-compose.yml --profile events up -d --wait",
    "infra:down": "docker compose -f infra/docker/docker-compose.yml down",
    "infra:reset": "docker compose -f infra/docker/docker-compose.yml down -v",
    "infra:setup:events": "PUBSUB_EMULATOR_HOST=localhost:8085 npx tsx services/api/scripts/setup-pubsub.ts",
    "migrate:up": "npm run migrate:up --workspace=@emek/api",
    "migrate:down": "npm run migrate:down --workspace=@emek/api",
    "audit:deps": "npm audit --audit-level=high",
    "sast": "semgrep --error --metrics=off --config p/typescript --config p/security-audit --config p/secrets --exclude node_modules --exclude dist . && semgrep --error --metrics=off --config .semgrep.yml .",
    "smoke": "tsx services/api/scripts/smoke-test.ts"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.11.0",
    "prettier": "^3.4.2",
    "tsx": "^4.23.0",
    "typescript": "^6.0.0",
    "typescript-eslint": "^8.70.0"
  },
  "overrides": {
    "multer": "^2.4.0"
  }
}
